# ==============================================================================
# Invisi-Scan Environment Configuration Template
# Copy this file to .env and replace placeholders with secure, generated secrets.
# NEVER commit the .env file or real secrets to version control.
# ==============================================================================

# Backend Security
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-random-32-byte-hex-string

# Fernet Key for encrypting report payloads
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=replace-with-a-valid-base64-fernet-key

# OpenAI API Key (optional - needed for AI Assistant & RAG capabilities)
OPENAI_API_KEY=your-openai-api-key-here

# Telegram Alerts (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Google OAuth (optional)
GOOGLE_CLIENT_ID=

# Web Push Notifications (optional)
# VAPID keys can be generated using `pywebpush` or `web-push`
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_CLAIM_EMAIL=mailto:security@example.com

# Default accounts seed passwords (optional)
DEFAULT_ADMIN_PASSWORD=admin123
DEFAULT_OPERATOR_PASSWORD=operator123

# Frontend Environment Variables
VITE_API_URL=http://localhost:8001
VITE_GOOGLE_CLIENT_ID=
